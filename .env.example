# Absolute origin of THIS deployment. Drives canonical URLs, OG tags, share and
# verify links, sitemap entries, robots.txt and any derived webhook URL.
# Never hardcode a domain in code -- change it here and redeploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://gbkpocjtcnozihvacmtg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8dFrNZTfk9bLs1xaiFQWBQ_eJwQno2Q
SUPABASE_SERVICE_ROLE_KEY=
# Owner connection: migrations, seeds, schema export, system jobs.
DATABASE_URL=
# Application connection (role `loom_app`, NOBYPASSRLS). Request handling only.
# Required for Row Level Security to be enforced at all — the owner above has
# rolbypassrls = true, which overrides FORCE ROW LEVEL SECURITY. Generate with:
#   node load/migrate.js && node load/create-app-role.js
# Falls back to DATABASE_URL when unset, so RLS stays a no-op rather than breaking.
DATABASE_APP_URL=
# Which chapter a server-to-server delivery (GitHub webhook, queue job) belongs
# to when the Host header carries no chapter identity.
DEFAULT_TENANT_SLUG=demo-college
DEV_TENANT_SLUG=demo-college
DEV_TENANT_DOMAIN=localhost
GITHUB_WEBHOOK_SECRET=dev-secret
# Signs credential share links; falls back to GITHUB_WEBHOOK_SECRET.
# Both must be real values in production (see assertProductionSecrets).
CREDENTIAL_SECRET=
QSTASH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=
# Google Search Console ownership. Two independent methods; either is enough.
#   1. HTML file: public/google<token>.html is served from the site root and the
#      middleware matcher excludes .html so an anonymous crawler is not
#      redirected to /login.
#   2. Meta tag: set this token (from Search Console -> Ownership -> HTML tag)
#      and redeploy. The tag is emitted once in app/layout.jsx.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=