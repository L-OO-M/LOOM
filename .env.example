# Absolute origin of THIS deployment. Drives canonical URLs, OG tags, share and
# verify links, sitemap entries, robots.txt and any derived webhook URL.
# Never hardcode a domain in code -- change it here and redeploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Owner connection: migrations, seeds, schema export, system jobs.
DATABASE_URL=
# Application connection (role `loom_app`, NOBYPASSRLS). Request handling only.
# Required for Row Level Security to be enforced at all — the owner above has
# rolbypassrls = true, which overrides FORCE ROW LEVEL SECURITY. Generate with:
#   node load/migrate.js && node load/create-app-role.js
# Truth: lib/env.js falls back to DATABASE_URL when this is unset, so local work
# still connects. Production startup validation (assertProductionSecrets, via
# lib/deploy-env-check.js) refuses to run without an EXPLICIT value, because the
# owner connection is rolbypassrls and would make every RLS policy decorative.
DATABASE_APP_URL=
# Which chapter a server-to-server delivery (GitHub webhook, queue job) belongs
# to when the Host header carries no chapter identity.
DEFAULT_TENANT_SLUG=
DEV_TENANT_SLUG=
DEV_TENANT_DOMAIN=localhost
# HMAC secret for /api/webhook. Required in production; any local value works
# for dev, e.g. `dev-secret`. Production refuses the literal `dev-secret`
# (see lib/deploy-env-check.js).
GITHUB_WEBHOOK_SECRET=
# --- Auth0: login/signup front door ---
# Server-only. AUTH0_SECRET encrypts the session cookie (>= 32 chars).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Set to 1 only after existing accounts are migrated; hides the legacy
# Supabase email/password and GitHub forms on /login and /register.
NEXT_PUBLIC_AUTH0_ONLY=0
# Server-side cutover. When true, the legacy Supabase register/login API returns
# 403 even if someone calls it directly. Keep 0 until accounts are migrated.
AUTH0_ONLY=0
# Optional: set the exact origin per deployment. Leave unset locally.
APP_BASE_URL=
# --- Auth0 Management API: password setup for social/email-linked accounts ---
# Create a Machine-to-Machine app authorized for the Auth0 Management API with
# read:users, create:users, update:users and delete:users. Never NEXT_PUBLIC_.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication
# Optional Auth0 migration settings. Set the connection ID from the Auth0 dashboard,
# or grant read:connections and set AUTH0_MIGRATION_SCOPES accordingly.
# AUTH0_DB_CONNECTION_ID=con_...
# AUTH0_MIGRATION_SCOPES=read:users create:users read:connections
# --- GitHub OAuth: the REPOSITORY grant (not sign-in) ---
# Sign-in with GitHub is configured in the Supabase dashboard and uses Supabase's
# own client credentials. These are for the separate `repo` grant that proves a
# student actually controls a repository -- Supabase's provider requests only
# `read:user user:email` and cannot prove ownership.
# Create at https://github.com/settings/developers -> OAuth Apps.
# Callback URL: <NEXT_PUBLIC_APP_URL>/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte base64 key for AES-256-GCM sealing of stored access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ROTATING THIS ORPHANS EVERY STORED TOKEN. Members must re-link; the UI must be
# ready to say so before you rotate, not after.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Optional: repository that hosts Debug & Build starter bugs, as "owner/repo".
# Defaults to L-OO-M/buggy. It must be public so students can fork it.
DEBUG_CHALLENGE_REPO=
# Signs credential share links and GitHub OAuth state. Required in production;
# deliberately does NOT fall back to GITHUB_WEBHOOK_SECRET.
# Both must be real values in production (see assertProductionSecrets).
CREDENTIAL_SECRET=
QSTASH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=
# --- Optional background work ---
# Bearer secret for POST /api/jobs/run (cron). Unset closes the endpoint.
CRON_SECRET=
# Server log verbosity: debug | info | warn | error. Defaults to info. Logs are
# one JSON line per event with a requestId and redacted secret/token fields.
LOG_LEVEL=
# Optional Resend delivery for the outbox email handler.
RESEND_API_KEY=
EMAIL_FROM=
# --- Legal notice values (see lib/legal.js) ---
# Defaults are honest but generic. Published pages read these at BUILD time.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_RETENTION_PERIOD=
LEGAL_GOVERNING_LAW=
LEGAL_LIABILITY_CAP=
LEGAL_PUBLISHED_DATE=
# Google Search Console ownership. Two independent methods; either is enough.
#   1. HTML file: public/google<token>.html is served from the site root and the
#      middleware matcher excludes .html so an anonymous crawler is not
#      redirected to /login.
#   2. Meta tag: set this token (from Search Console -> Ownership -> HTML tag)
#      and redeploy. The tag is emitted once in app/layout.jsx.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: mirror feature requests into GitHub Issues. Both are required for
# the bridge to work; leaving either empty keeps it off (submissions still save).
# GITHUB_ISSUES_REPO must be "owner/repo". The token is a fine-grained PAT with
# Issues: Read and write on that repo (classic PAT with `repo` also works).
# Server-only: never prefix with NEXT_PUBLIC_. After setting these in Vercel,
# redeploy, then backfill existing requests with:
#   node load/sync-feature-requests.js --apply
GITHUB_ISSUES_REPO=
GITHUB_ISSUES_TOKEN=
# --- Optional storage / crawler controls ---
# Object-storage bucket used by load/setup-storage.js and the upload adapter.
# Leave unset for the default `loom-files`.
SUPABASE_STORAGE_BUCKET=
# Set to 1 to emit `ai-train=no` crawler directives in robots.txt.
AEO_BLOCK_TRAINING=
# Optional override for the Auth0 Management API scopes (see
# lib/auth0-management.js). The default includes delete:users because the
# password-identity rollback deletes a half-created user on failure.
AUTH0_MANAGEMENT_SCOPES=
# --- Local/CI scripts only (not read by the running app) ---
# Seed targets and the alternative owner connection used by load/*.js.
SEED_TENANT_SLUG=
SEED_TENANT_NAME=
DATABASE_URL_TARGET=
DATABASE_URL_MUMBAI=
# load/verify-webhook.js uses this URL when it cannot derive one from
# NEXT_PUBLIC_APP_URL; load/sync-oss-repos.js accepts a plain GitHub token.
GITHUB_WEBHOOK_URL=
GITHUB_TOKEN=
# End-to-end credentials; see e2e/ and AGENTS.md. Never point these at a
# chapter with real member data.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
E2E_STUDENT_NAME=
E2E_STUDENT_DOMAIN=

